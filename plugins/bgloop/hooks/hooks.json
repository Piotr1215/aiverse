{
  "description": "bgloop observers: UserPromptSubmit relays pending actions and queues the prompt coach, Stop closes the turn marker",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/observers/prompt_coach.py\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/observers/prompt_coach.py\" turn-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
